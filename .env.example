# ScentWise Environment Configuration

# Server
PORT=3001
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scentwise
DB_USER=postgres
DB_PASSWORD=your_password_here

# Gemini API (Optional)
# If not provided, the platform will use deterministic fallback descriptions
GEMINI_API_KEY=your_gemini_api_key_here
